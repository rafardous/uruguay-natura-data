# EAS archives the Git root. Upload only the mobile project and its runtime assets.
*
!NaturaUY-source
!NaturaUY-source/**
NaturaUY-source/node_modules/
NaturaUY-source/.expo/
NaturaUY-source/android/
NaturaUY-source/ios/
NaturaUY-source/dist/
NaturaUY-source/web-build/
NaturaUY-source/.npm/
NaturaUY-source/.metro-cache/
NaturaUY-source/.gradle-user-home/
NaturaUY-source/.env*
NaturaUY-source/credentials.json
NaturaUY-source/credentials/
NaturaUY-source/*.jks
NaturaUY-source/*.key
NaturaUY-source/*.p8
NaturaUY-source/*.p12
NaturaUY-source/data/cache/
NaturaUY-source/data/raw/
NaturaUY-source/scripts/.cache/
NaturaUY-source/scripts/out/
**/*.log
**/*.orig.*
**/*.sql.dpapi
**/*.apk
**/*.aab
**/.android-user-home/
**/.android-emulator-home/
**/credentials.json
**/.env*
**/*.sql.gz.enc
