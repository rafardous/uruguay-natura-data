{
  "expo": {
    "name": "Arapy",
    "slug": "natura-uy",
    "version": "1.3.1",
    "orientation": "portrait",
    "scheme": "naturauy",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uy.naturauy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uy.naturauy.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#CBD8C4"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#CBD8C4",
          "dark": {
            "backgroundColor": "#CBD8C4"
          }
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio"
    ],
    "assetBundlePatterns": [
      "assets/db/*",
      "assets/thumbs/*"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "catalogManifestUrl": "https://uruguay-natura-data.pages.dev/catalog/manifest.json",
      "eas": {
        "projectId": "19da2ae0-b85c-4ed8-9dbc-f26fe80c6a8e"
      }
    },
    "owner": "rafardousdocente"
  }
}
